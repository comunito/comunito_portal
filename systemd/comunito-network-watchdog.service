[Unit]
Description=Comunito network and Tailscale recovery check
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RuntimeDirectory=comunito
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30
ExecStart=/usr/local/sbin/comunito-network-watchdog
